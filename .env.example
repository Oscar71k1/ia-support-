# Copiar a .env y completar. .env NO se versiona (ver .gitignore).
# Este archivo solo contiene nombres y valores de ejemplo.

# --- Proveedor generativo ---
# groq | ollama | openai
LLM_PROVIDER=groq

# Interfaz OpenAI-compatible. Cambiar de proveedor = cambiar estas 3 líneas.
LLM_BASE_URL=https://api.groq.com/openai/v1
LLM_MODEL=
LLM_API_KEY=

# Presupuesto de la llamada
LLM_TIMEOUT_MS=20000
LLM_TEMPERATURE=0
LLM_MAX_TOKENS=400

# --- API ---
PORT=3000
